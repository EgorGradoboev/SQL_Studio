<Window x:Class="SQL_Studio.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQL_Studio"
        mc:Ignorable="d"
        Title="HistoryWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="HistoryGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  ItemsSource="{Binding HistoryQueries}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                
                <!-- Row ID -->
                <DataGridTextColumn Header="ID"
                                    Width="50"
                                    Binding="{Binding RowId}"/>
                <!-- Execution Time -->
                <DataGridTextColumn Header="Execution Time"
                                    Width="150"
                                    Binding="{Binding ExecutionTime}"/>
                <!-- Query -->
                <DataGridTextColumn Header="Query Text"
                                    Width="*"
                                    
                                    Binding="{Binding QueryText}"/>
                <!-- Select Button -->
                <DataGridTextColumn Header="Select"
                                    Width="150"
                                    />


            </DataGrid.Columns>
            
        </DataGrid>
    </Grid>
</Window>
