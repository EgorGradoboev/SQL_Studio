<Window x:Class="SQL_Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQL_Studio"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SQL_Studio.ViewModels"
        mc:Ignorable="d"
        Loaded="MainWindow_Loaded"
        Title="SQL Studio" Height="650" Width="1000"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate DataType="{x:Type vm:QueryViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Ask AI -->
                <StackPanel Grid.Row="0"
                            Margin="4,4,4,8"
                            Visibility="{Binding IsAiAvailable, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Text="{Binding AiQuestion, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Ask your database in plain language..."
                            VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AskAiCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button
                            Grid.Column="1"
                            Content="ASK AI"
                            Command="{Binding AskAiCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="8,0,0,0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                Visibility="{Binding IsApiKeyMissing, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Anthropic API key is not set."
                                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="SET KEY"
                                Command="{Binding SetApiKeyCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AiStatus}" Margin="0,4,0,0" Opacity="0.7"/>
                </StackPanel>

                <TextBox
                    x:Name="QueryTextBox"
                    Grid.Row="1"
                    Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="QueryTextBox_TextChanged"
                    PreviewKeyDown="QueryTextBox_PreviewKeyDown"
                    AcceptsReturn="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
                <Popup
                    Grid.Row="1"
                    x:Name="AutoCompletePopup"
                    IsOpen="{Binding IsAutoCompleteOpen}"
                    PlacementTarget="{Binding ElementName=QueryTextBox}"
                    Placement="Relative"
                    StaysOpen="False"
                    AllowsTransparency="True">
                    <materialDesign:Card
                        Background="{DynamicResource MaterialDesignPaper}"
                        UniformCornerRadius="4"
                        Padding="0"
                        MinWidth="220"
                        MaxHeight="220">
                        <ListBox
                            x:Name="SuggestionsListBox"
                            ItemsSource="{Binding Suggestions}"
                            SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                            BorderThickness="0"
                            Background="Transparent"/>
                    </materialDesign:Card>
                </Popup>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="12">

        <!-- Rows -->
        <Grid.RowDefinitions>

            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>

            <!-- Main block -->
            <RowDefinition Height="*"/>

            <!-- Results-->
            <RowDefinition Height="220"/>

        </Grid.RowDefinitions>

        <!-- Columns -->
        <Grid.ColumnDefinitions>

            <!-- Left -->
            <ColumnDefinition Width="260"/>

            <!-- Right -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- TOOLBAR -->
        <materialDesign:Card Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,12"
                Padding="8">
            <StackPanel Orientation="Horizontal">

                <Button
                    Click="Button_ChangeServer"
                    Content="CONNECT TO SERVER"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,4,0"/>

                <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="4,4"/>

                <Button
                    Content="EXECUTE"
                    Command="{Binding QueryTabs.SelectedTab.ExecuteCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="4,0,4,0"/>
                <Button
                    Content="CANCEL"
                    Command="{Binding QueryTabs.SelectedTab.CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,4,0"/>

                <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="4,4"/>

                <Button                    
                    Content="NEW QUERY"
                    Command="{Binding QueryTabs.NewTabCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,4,0"/>
                <Button
                    Content="CLOSE QUERY"
                    Command="{Binding QueryTabs.CloseTabCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,4,0"/>
                <Button
                    Content="SHOW HISTORY"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding ShowHistoryCommand}"/>

            </StackPanel>
        </materialDesign:Card>

        <!-- Left block -->
        <materialDesign:Card Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="0"
                Margin="0,0,12,0"
                Padding="4">
            <TreeView x:Name="ItemsTree"
                      ItemsSource="{Binding Servers}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

        </materialDesign:Card>

        <!-- Query tabs -->
        <materialDesign:Card Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,12">
            <TabControl
                    x:Name="QueryTabs"
                    ItemsSource="{Binding QueryTabs.Tabs}"
                    SelectedItem="{Binding QueryTabs.SelectedTab}"
                    ItemTemplate="{StaticResource QueryTabHeaderTemplate}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight"/>
        </materialDesign:Card>

        <!-- Results -->
        <materialDesign:Card Grid.Row="2"
            Grid.Column="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0">

                    <TabItem Header="Results">

                        <DataGrid
                            x:Name="ResultsGrid"
                            ItemsSource="{Binding QueryTabs.SelectedTab.QueryResults}"
                            Margin="4"/>

                    </TabItem>
                    <TabItem Header="Message">

                        <TextBlock
                            x:Name="MessageTextBlock"
                            Text="{Binding QueryTabs.SelectedTab.StatusMessage}"
                            Margin="8"/>

                    </TabItem>

                </TabControl>

                <!-- Execution timer -->
                <TextBlock
                    x:Name="ExecutionTimeBlock"
                    Text="{Binding QueryTabs.SelectedTab.ExecutionTimerText}"
                    Grid.Row="1"
                    Margin="8,4,8,8"
                    HorizontalAlignment="Right"
                    Opacity="0.7"/>
            </Grid>

        </materialDesign:Card>

    </Grid>

</Window>