<Window x:Class="SQL_Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQL_Studio"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>

        <!-- СТРОКИ -->
        <Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <RowDefinition Height="50"/>

            <!-- Основная область -->
            <RowDefinition Height="*"/>

            <!-- Результаты -->
            <RowDefinition Height="200"/>

        </Grid.RowDefinitions>

        <!-- КОЛОНКИ -->
        <Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <ColumnDefinition Width="250"/>

            <!-- Правая область -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- TOOLBAR -->
        <StackPanel Grid.Row="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Margin="10">

            <Button 
                Click="Button_Connect"
                Content="Connect"
                Width="100"
                Margin="0,0,10,0"/>
            <Button 
                Click="Button_Disconnect"
                Content="Disconnect"
                Width="100"
                Margin="0,0,10,0"/>

            <Button 
                Click="Button_Execute"
                Content="Execute"
                Width="100"
                Margin="0,0,10,0"/>

            <Button 
                Click="Button_NewQuery"
                Content="New query"
                Width="100"
                Margin="0,0,10,0"/>
            <Button 
                Click="Button_CloseQuery"
                Content="Close query"
                Width="100"
                Margin="0,0,10,0"/>
            <Button 
                Click="Button_HistoryQuery"
                Content="Show history"
                Width="100"
                Margin="0,0,10,0"/>

        </StackPanel>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <TreeView x:Name="ItemsTree"
          Grid.Row="1"
          Grid.Column="0"
          Margin="10">
            
        </TreeView>

        <TextBox 
              x:Name="ConnectionTextBox"
              Grid.Row="2"
              Grid.Column="0"
              Margin="10,18,10,18"/>

        <!-- ТАБЫ С ЗАПРОСАМИ -->
        <TabControl 
                x:Name="QueryTabs"
                Grid.Row="1"
                Grid.Column="1"
                Margin="10">

        </TabControl>

        <!-- РЕЗУЛЬТАТЫ -->

        <TabControl Grid.Row="2"
            Grid.Column="1"
            Margin="10">

            <TabItem Header="Results">

                <DataGrid 
                    x:Name="ResultsGrid"
                    Margin="10"/>

            </TabItem>
            <TabItem Header="Message">

                <TextBox
                    x:Name="MessageTextBlock"
                    Margin="10"/>

            </TabItem>

        </TabControl>

    </Grid>


</Window>
