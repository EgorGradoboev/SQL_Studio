<Window x:Class="SQL_Studio.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQL_Studio"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Connect to server"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}">

    <materialDesign:Card Margin="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ComboBox
                x:Name="RecentConnectionsComboBox"
                Grid.Row="0"
                Margin="0,0,0,16"
                Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                materialDesign:HintAssist.Hint="Recent connections"
                DisplayMemberPath="DisplayName"
                SelectionChanged="RecentConnectionsComboBox_SelectionChanged"/>

            <TextBox
                x:Name="ServerConnectionTextBox"
                Grid.Row="1"
                Margin="0,0,0,16"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                materialDesign:HintAssist.Hint="Server name"/>

            <TextBox
                x:Name="PortConnectionTextBox"
                Grid.Row="2"
                Margin="0,0,0,16"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                materialDesign:HintAssist.Hint="Port"/>

            <TextBox
                x:Name="LoginTextBox"
                Grid.Row="3"
                Margin="0,0,0,16"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                materialDesign:HintAssist.Hint="Login"/>

            <PasswordBox
                x:Name="PasswordTextBox"
                Grid.Row="4"
                Margin="0,0,0,16"
                Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                materialDesign:HintAssist.Hint="Password"/>

            <StackPanel
                Grid.Row="5"
                Margin="0,8,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button
                    Click="Button_CancelConnect"
                    Content="CANCEL"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0"/>
                <Button
                    Click="Button_ConnectServer"
                    Content="CONNECT"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window>
